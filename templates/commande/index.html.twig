{% extends 'base.html.twig' %}

{% block title %}Hello CommandeController!{% endblock %}

{% block body %}
<P>Votre panier est vide</P>
<main class="container">
        <section class="row">
            <div class="col-12">
                <h1>Panier</h1>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Prix</th>
                            <th>Quantité</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
{% for p in data %}

    <tr>
        <td>{{ p.produit.nom }}</td>
        <td>{{ p.produit.prix / 100 }} €</td>
        <td>{{ p.quantite }}</td>
        <td>{{ p.quantite * p.produit.prix / 100 }} €</td>
        <td>
            <a href="{{ path('cart_add', {id: p.produit.id}) }}" class="btn btn-success">+</a>
            <a href="{{ path('cart_remove', {id: p.produit.id}) }}" class="btn btn-warning">-</a>
            <a href="{{ path('cart_delete', {id: p.produit.id}) }}" class="btn btn-danger">Supprimer</a>
        </td>
    </tr>

{{p['produit'].nomproduit}} - {{p['quantite']}}
<button onclick "<a href={{ path('app_detailsproduits', {'id': p['produit'].id}) }}></a>">ajouter au panier</button>


    
                            
{% else %}
    <tr>
        <td colspan="5">Votre panier est vide</td>
    </tr>    
{% endfor %}
                    </tbody>

{% endblock %}
